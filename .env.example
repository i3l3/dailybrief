DATABASE_URL=postgresql://dailybrief:change-this-database-password@localhost:15432/dailybrief
DB_PORT=15432
POSTGRES_PASSWORD=change-this-database-password
APP_URL=http://localhost:3000
# Generate MASTER_KEY with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=
# Set true for HTTPS, including HTTPS behind your private reverse proxy.
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact hosts only, comma-separated; permits private school IMAP hosts.
IMAP_ALLOWED_HOSTS=

# Apps Script bridge (Compose service: bridge, internal port: 8787)
# Generate a random token with the same command as MASTER_KEY, but a NEW value.
# Set the same token in Apps Script Script Properties as BRIDGE_TOKEN.
BRIDGE_TOKEN=
# Dokploy HTTPS domain routed to service bridge / container port 8787.
# Set this URL in Apps Script Script Properties as BRIDGE_URL.
BRIDGE_PUBLIC_URL=https://brief-bridge.example.com
# Optional for public read-only dashboard; needed only for bridge Gmail OAuth.
GAS_WEB_APP_URL=https://script.google.com
