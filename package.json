{
  "name": "dailybrief",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "worker": "tsx --env-file-if-exists=.env worker/index.ts",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx scripts/integration.ts"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "pg": "^8.16.3",
    "pg-boss": "^12.38.0",
    "zod": "^4.1.12",
    "imapflow": "^2.9.0",
    "mailparser": "^3.9.0",
    "fast-xml-parser": "^5.3.0",
    "cheerio": "^1.1.2",
    "ipaddr.js": "^2.2.0",
    "undici": "^7.16.0",
    "lucide-react": "^0.468.0",
    "@fontsource-variable/noto-sans-kr": "^5.2.8",
    "tsx": "^4.20.6",
    "tailwindcss": "^4.1.16",
    "@tailwindcss/postcss": "^4.1.16"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/pg": "^8.15.6",
    "@types/mailparser": "^3.4.6"
  }
}
